{
  "name": "@org/source",
  "version": "0.0.0",
  "license": "MIT",
  "description": "TCP Kit - developer CLI/TUI for TCP microservices (Nx workspace root)",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/shivam-070208/tcpkit.git"
  },
  "homepage": "https://github.com/shivam-070208/tcpkit#readme",
  "bugs": {
    "url": "https://github.com/shivam-070208/tcpkit/issues"
  },
  "scripts": {
    "build": "npx nx run-many -t build --parallel=3",
    "build:all": "npx nx run-many -t build --parallel=3",
    "test": "npx nx run-many -t test --parallel=3",
    "publish": "bash ./scripts/publish.sh",
    "publish:dry": "bash ./scripts/publish.sh --dry-run",
    "publish:tcpkit": "bash ./scripts/publish-tcpkit.sh",
    "publish:next": "bash ./scripts/publish.sh --tag next",
    "release": "npx nx release --verbose",
    "release:dry": "npx nx release --dry-run --verbose",
    "release:patch": "npx nx release patch --verbose --yes",
    "release:minor": "npx nx release minor --verbose --yes",
    "release:major": "npx nx release major --verbose --yes",
    "release:first": "npx nx release --first-release --verbose",
    "version:patch": "npx nx release patch --skip-publish --verbose",
    "version:minor": "npx nx release minor --skip-publish --verbose"
  },
  "private": true,
  "dependencies": {
    "ink": "^7.1.1",
    "react": "^19.3.0",
    "zod": "^4.5.4"
  },
  "devDependencies": {
    "@eslint/js": "^9.8.0",
    "@nx/eslint": "23.2.0",
    "@nx/eslint-plugin": "23.2.0",
    "@nx/jest": "23.2.0",
    "@nx/js": "23.2.0",
    "@swc-node/register": "1.11.1",
    "@swc/core": "1.15.8",
    "@swc/helpers": "0.5.18",
    "@swc/jest": "~0.2.38",
    "@types/jest": "~30.0.0",
    "@types/node": "^24.0.0",
    "@types/react": "^19.3.0",
    "eslint": "^9.8.0",
    "eslint-config-prettier": "^10.0.0",
    "jest": "~30.3.0",
    "jest-environment-node": "~30.3.0",
    "jest-util": "~30.3.0",
    "jsonc-eslint-parser": "^2.1.0",
    "nx": "23.2.0",
    "prettier": "^3.8.1",
    "ts-jest": "^29.4.7",
    "ts-node": "10.9.1",
    "tslib": "^2.3.0",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.58.0",
    "verdaccio": "^6.3.2"
  },
  "workspaces": [
    "packages/*",
    "libs/*",
    "apps/*"
  ],
  "nx": {
    "includedScripts": [],
    "targets": {
      "local-registry": {
        "executor": "@nx/js:verdaccio",
        "options": {
          "port": 4873,
          "config": ".verdaccio/config.yml",
          "storage": "tmp/local-registry/storage"
        }
      }
    }
  }
}
