  "description": "TCP Kit TUI - Ink/React terminal UI for TCP interactions",
  "keywords": ["tcp", "tui", "ink", "react", "tcpkit"],
  "author": "Shivam <shivam-070208@github>",
  "license": "MIT",
  "repository": {
    "type": "git",
